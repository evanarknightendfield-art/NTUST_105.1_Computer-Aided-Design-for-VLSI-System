.limit
fanout 4		# maximum fanouts for SRC
length 3200	# maximum length for SRC
.dimx 4000	# chip dimension in x-axis
.dimy 4000	# chip dimension in y-axis
.e

.buflib 3
# type	#F	#L	#C #fanout/length/cost
SMALL	3	450	10
MEDIUM	6	600	16
LARGE	9	950	22
.e

.objective
w_skew 10
.e

