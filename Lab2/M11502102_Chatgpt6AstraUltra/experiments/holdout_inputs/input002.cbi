.limit
fanout 2		# maximum fanouts for SRC
length 400	# maximum length for SRC
.dimx 500	# chip dimension in x-axis
.dimy 500	# chip dimension in y-axis
.e

.buflib 3
# type	#F	#L	#C #fanout/length/cost
