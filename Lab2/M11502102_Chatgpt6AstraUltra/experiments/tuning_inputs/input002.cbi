.limit
fanout 4		# maximum fanouts for SRC
length 315	# maximum length for SRC
.dimx 450	# chip dimension in x-axis
.dimy 450	# chip dimension in y-axis
.e

.buflib 5
# type	#F	#L	#C #fanout/length/cost
TINY	2	60	6
SMALL	3	135	10
MEDIUM	6	180	16
LARGE	9	285	22
HUGE	16	600	45
.e

.objective
w_skew 5
.e

