.limit
fanout 4		# maximum fanouts for SRC
length 1080	# maximum length for SRC
.dimx 1200	# chip dimension in x-axis
.dimy 1200	# chip dimension in y-axis
.e

.buflib 5
# type	#F	#L	#C #fanout/length/cost
TINY	2	436	6
SMALL	3	982	10
MEDIUM	6	1309	16
LARGE	9	2073	22
HUGE	16	4364	45
.e

.objective
w_skew 5
.e

