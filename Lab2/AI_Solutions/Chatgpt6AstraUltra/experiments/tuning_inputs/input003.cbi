.limit
fanout 2		# maximum fanouts for SRC
length 700	# maximum length for SRC
.dimx 1000	# chip dimension in x-axis
.dimy 1000	# chip dimension in y-axis
.e

.buflib 3
# type	#F	#L	#C #fanout/length/cost
SMALL	3	180	10
MEDIUM	6	240	16
LARGE	9	380	22
.e

.objective
w_skew 2
.e

