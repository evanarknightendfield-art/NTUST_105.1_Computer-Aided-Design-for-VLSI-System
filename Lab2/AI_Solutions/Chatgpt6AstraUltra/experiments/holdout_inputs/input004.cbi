.limit
fanout 1		# maximum fanouts for SRC
length 1440	# maximum length for SRC
.dimx 1800	# chip dimension in x-axis
.dimy 1800	# chip dimension in y-axis
.e

.buflib 5
# type	#F	#L	#C #fanout/length/cost
TINY	2	120	6
SMALL	3	270	10
MEDIUM	6	360	16
LARGE	9	570	22
HUGE	16	1200	45
.e

.objective
w_skew 1
.e

