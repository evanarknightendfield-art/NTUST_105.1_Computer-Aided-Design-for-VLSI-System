.limit
fanout 2		# maximum fanouts for SRC
length 2400	# maximum length for SRC
.dimx 3000	# chip dimension in x-axis
.dimy 3000	# chip dimension in y-axis
.e

.buflib 3
# type	#F	#L	#C #fanout/length/cost
SMALL	3	360	10
MEDIUM	6	480	16
LARGE	9	760	22
.e

.objective
w_skew 3
.e

