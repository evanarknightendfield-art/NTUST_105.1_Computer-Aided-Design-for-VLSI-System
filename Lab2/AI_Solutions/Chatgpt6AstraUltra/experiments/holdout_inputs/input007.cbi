.limit
fanout 1		# maximum fanouts for SRC
length 120	# maximum length for SRC
.dimx 150	# chip dimension in x-axis
.dimy 150	# chip dimension in y-axis
.e

.buflib 5
# type	#F	#L	#C #fanout/length/cost
TINY	2	40	6
SMALL	3	90	10
MEDIUM	6	120	16
LARGE	9	190	22
HUGE	16	400	45
.e

.objective
w_skew 1
.e

