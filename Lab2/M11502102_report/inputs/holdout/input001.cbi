.limit
fanout 2		# maximum fanouts for SRC
length 58	# maximum length for SRC
.dimx 65	# chip dimension in x-axis
.dimy 65	# chip dimension in y-axis
.e

.buflib 3
# type	#F	#L	#C #fanout/length/cost
SMALL	3	45	10
