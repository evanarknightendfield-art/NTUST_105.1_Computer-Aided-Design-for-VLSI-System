.e

.objective
w_skew 5
.e

.pin 6		# number of pins
0 9		# clock SRC coordinates
40 18		# clock sink S1 coordinates
51 29		# clock sink S2 coordinates
41 25		# clock sink S3 coordinates
48 21		# clock sink S4 coordinates
40 16		# clock sink S5 coordinates
.e
