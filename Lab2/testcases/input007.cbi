.limit
fanout 4		# maximum fanouts for SRC
length 720	# maximum length for SRC
.dimx 800	# chip dimension in x-axis
.dimy 800	# chip dimension in y-axis
.e

.buflib 3
# type	#F	#L	#C #fanout/length/cost
SMALL	3	180	10
MEDIUM	6	240	16
LARGE	9	380	22
.e

.objective
w_skew 1
.e

