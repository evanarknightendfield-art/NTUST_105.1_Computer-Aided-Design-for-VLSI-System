.limit
fanout 3		# maximum fanouts for SRC
length 450	# maximum length for SRC
.dimx 500	# chip dimension in x-axis
.dimy 500	# chip dimension in y-axis
.e

.buflib 3
# type	#F	#L	#C #fanout/length/cost
SMALL	3	90	10
MEDIUM	6	120	16
LARGE	9	190	22
.e

.objective
w_skew 1
.e

