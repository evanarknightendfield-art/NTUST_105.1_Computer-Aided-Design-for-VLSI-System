.limit
fanout 9		# maximum fanouts for SRC
length 1000	# maximum length for SRC
.dimx 100	# chip dimension in x-axis
.dimy 100	# chip dimension in y-axis
.e

.buflib 3
# type	#F	#L	#C #fanout/length/cost
SMALL	3	90	10
MEDIUM	6	120	16
LARGE	9	190	22
.e

.objective
w_skew 1
.e

.pin 9		# number of pins
13 97		# clock SRC coordinates
30 93		# clock sink S1 coordinates
49 72		# clock sink S2 coordinates
76 40		# clock sink S3 coordinates
44 66		# clock sink S4 coordinates
31 73		# clock sink S5 coordinates
62 1		# clock sink S6 coordinates
91 11		# clock sink S7 coordinates
41 50		# clock sink S8 coordinates
.e
