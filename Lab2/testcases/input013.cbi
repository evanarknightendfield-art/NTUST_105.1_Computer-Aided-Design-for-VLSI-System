.limit
fanout 2		# maximum fanouts for SRC
length 100	# maximum length for SRC
.dimx 120	# chip dimension in x-axis
.dimy 120	# chip dimension in y-axis
.e

.buflib 3
# type	#F	#L	#C #fanout/length/cost
SMALL	3	90	10
MEDIUM	6	120	16
LARGE	9	190	22
.e

.objective
w_skew 1
.e

