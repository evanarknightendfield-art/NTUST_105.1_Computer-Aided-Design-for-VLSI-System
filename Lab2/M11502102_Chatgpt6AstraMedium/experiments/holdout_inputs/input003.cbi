.limit
fanout 8		# maximum fanouts for SRC
length 630	# maximum length for SRC
.dimx 700	# chip dimension in x-axis
.dimy 700	# chip dimension in y-axis
.e

.buflib 3
# type	#F	#L	#C #fanout/length/cost
SMALL	3	573	10
MEDIUM	6	764	16
LARGE	9	1209	22
.e

.objective
w_skew 20
.e

