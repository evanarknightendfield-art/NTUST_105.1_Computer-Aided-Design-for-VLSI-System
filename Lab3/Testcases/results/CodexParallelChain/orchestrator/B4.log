diff --git a/Lab3/AI_Solutions/CodexParallelChain/src/chain_beam.hpp b/Lab3/AI_Solutions/CodexParallelChain/src/chain_beam.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..c3d21c1f9dda36936bdb016425bce907bbec89e3
--- /dev/null
+++ b/Lab3/AI_Solutions/CodexParallelChain/src/chain_beam.hpp
@@ -0,0 +1,24 @@
+#pragma once
+#include <algorithm>
+#include <vector>
+
+// Select the same occupied and empty beams as a full sort, without sorting
+// the candidates that will be discarded. The comparator must totally order
+// candidates (the production comparator ends with unique segment/site keys).
+template<class Candidate, class Less>
+void retainChainBeam(std::vector<Candidate>& values, int branches, Less less) {
+    auto split = std::partition(values.begin(), values.end(),
+                               [](const Candidate& c) { return c.count == 0; });
+    const auto emptyCount = std::min(split - values.begin(),
+                                    decltype(split - values.begin())(std::max(4, branches / 2)));
+    const auto occupiedCount = std::min(values.end() - split,
+                                       decltype(values.end() - split)(branches));
+    std::partial_sort(values.begin(), values.begin() + emptyCount, split, less);
+    std::partial_sort(split, split + occupiedCount, values.end(), less);
+    // Copy forward: the destination never lies after its source. This also
+    // handles overlap when few empty candidates were discarded.
+    for (decltype(occupiedCount) i = 0; i < occupiedCount; ++i)
+        values[emptyCount + i] = split[i];
+    values.resize(emptyCount + occupiedCount);
+    std::sort(values.begin(), values.end(), less);
+}
diff --git a/Lab3/AI_Solutions/CodexParallelChain/tests/chain_beam_test.cpp b/Lab3/AI_Solutions/CodexParallelChain/tests/chain_beam_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..f2da2186adf37d459bd38f9f8a180598b76a3e19
--- /dev/null
+++ b/Lab3/AI_Solutions/CodexParallelChain/tests/chain_beam_test.cpp
@@ -0,0 +1,41 @@
+#include "../src/chain_beam.hpp"
+#include <iostream>
+#include <random>
+#include <stdexcept>
+#include <tuple>
+
+struct Choice { int count, score, distance, seg, site; };
+
+int main() {
+    std::mt19937 rng(81273);
+    auto less = [](const Choice& a, const Choice& b) {
+        return std::tie(a.score, a.distance, a.count, a.seg, a.site) <
+               std::tie(b.score, b.distance, b.count, b.seg, b.site);
+    };
+    // Independent oracle: v6's complete ordering followed by beam filtering.
+    // Exercise empty/occupied imbalance, overlapping compaction, score ties,
+    // odd beam sizes, empty input, and beams larger than the candidate set.
+    for (int trial = 0; trial < 2400; ++trial) {
+        std::vector<Choice> input;
+        int n = trial < 100 ? trial : int(rng() % 1000);
+        int branches = 1 + rng() % 32;
+        for (int i = 0; i < n; ++i) {
+            int count = trial % 4 == 0 ? 0 : trial % 4 == 1 ? 1 : int(rng() % 3);
+            input.push_back({count, int(rng() % 17) - 8, int(rng() % 7), i / 8, i % 8});
+        }
+        std::shuffle(input.begin(), input.end(), rng);
+        auto actual = input, ordered = input;
+        std::sort(ordered.begin(), ordered.end(), less);
+        std::vector<Choice> expected;
+        int occupied = 0, empty = 0;
+        for (const auto& c : ordered)
+            if (c.count ? ++occupied <= branches : ++empty <= std::max(4, branches / 2))
+                expected.push_back(c);
+        retainChainBeam(actual, branches, less);
+        if (actual.size() != expected.size()) throw std::runtime_error("beam size mismatch");
+        for (size_t i = 0; i < actual.size(); ++i)
+            if (less(actual[i], expected[i]) || less(expected[i], actual[i]))
+                throw std::runtime_error("beam differs from full-sort oracle");
+    }
+    std::cout << "2400 exact beam comparisons passed\n";
+}

