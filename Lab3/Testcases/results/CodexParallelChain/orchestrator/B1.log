// annealer.hpp — Stage 2: simulated annealing on total HPWL with legality-preserving moves.
#pragma once
#include <cstdint>
#include <string>

#include "placedb.hpp"

struct SAOptions {
    uint64_t seed = 1;
    double timeLimit = 60;        // seconds; moves per step shrink to fit
    double movesPerCell = 5000;   // attempted moves = movesPerCell * #movable cells ...
    double minMoves = 5e6;        // ... but at least this many (small designs anneal properly)
    double maxMoves = 6e7;        // v3: ... and at most this many (big designs keep ~1 min)
    int steps = 100;              // temperature steps (T0 -> T0 * tEndRatio, geometric)
    double p0 = 0.8;              // acceptance probability of an average uphill move at T0
    double tEndRatio = 1e-3;
    double pTarget = 0.5;         // chance a move aims at the cell's optimal region
    double win0 = 0.05;           // initial range window, as a fraction of the chip
    double maxWin = 0.1;          // v2: largest range window, as a fraction of the chip
    double pGlobalSwap = 0.04;   // cold multi-candidate global/vertical swaps
    double pRowOpt = 0.01;        // v3: chance of a linear-placement window move
    int rowWin = 12;              //     cells per linear-placement window
    double pIsm = 0.01;           // v3: chance of an independent-set-matching move
    int ismSize = 12;             //     cells per matching
    double ismReach = 3;          //     candidates within this many minimum windows in x (+-2 rows)
    double polishFrom = 0.5;      // v3: rowopt / ism only from this fraction of the temperature steps on
    double minWinCells = 4;       // smallest window: this many average cell widths ...
    double minWinRows = 1.5;      // ... and this many rows
    bool clampTarget = false;     // optimal-region moves also obey the window (worse in tests)
    double pReorder = 0.1;        // v2: chance of a local-reordering move (3 neighbours)
    int nearTries = -1;           // v2: if the target fails, cells/gaps tried on each side of it;
                                  //     -1 = auto: 3 when utilization >= 0.72, else 0
    int threads = 0;              // v4: parallel SA worker threads (0 = auto: hardware, at most 8)
    int minBandRows = 12;         // v4: rows per band at least (fewer threads on short chips)
    double syncMoves = 1.0;       // v4: bands merge after about this many attempts per cell
    double starvedAttemptsPerCell = 100;   // v6: parallel SA: fewer projected attempts per cell -> keep only ...
    double starvedMinFraction = 0.1;       // v6: ... this fraction of timeLimit (the rest goes to the polish); 0 = off
    std::string tracePath;        // CSV trace for the report plot (empty = none)
    bool verbose = false;
};

struct SAResult {
    double initial = 0, best = 0;
    long long attempts = 0, accepted = 0;
    double seconds = 0;
    double limitCut = 0;   // v6: seconds of timeLimit given up by a starved SA (main hands them to the polish)
};

// Improves P in place; P stays legal after every accepted move, and the best
// placement seen is returned.
SAResult anneal(const PlaceDB& db, Placement& P, const SAOptions& opt);
// v4: number of worker threads anneal() will use for this design.
int saThreads(const PlaceDB& db, const SAOptions& opt);
#include "../src/annealer.hpp"
#include <cmath>
#include <iostream>
#include <stdexcept>

void require(bool condition, const char* message) {
    if (!condition) throw std::runtime_error(message);
}

int main() {
    PlaceDB db;
    db.uniformSites = true;
    db.siteSpacing = 1;
    Placement original;
    constexpr int count = 2000, rows = 40, perRow = count / rows;
    for (int row = 0; row < rows; ++row) {
        db.rows.push_back({double(row), 1, {row}});
        db.segs.push_back({row, double(row), 1, 0, 1, 120});
    }
    for (int v = 0; v < count; ++v) {
        Node cell;
        cell.name = "c" + std::to_string(v);
        cell.w = cell.h = 1;
        cell.gx = 2 * (v % perRow);
        cell.gy = v / perRow;
        db.nodes.push_back(cell);
        db.movable.push_back(v);
        db.wSites.push_back(1);
        original.seg.push_back(v / perRow);
        original.site.push_back(2 * (v % perRow));
    }
    db.nodeNets.resize(count);
    for (int v = 0; v < count; ++v) {
        int other = (37 * v + 19) % count;
        db.nets.push_back({v, other});
        db.nodeNets[v].push_back(v);
        db.nodeNets[other].push_back(v);
    }
    require(checkLegal(db, original).empty(), "invalid test fixture");
    SAOptions options;
    options.threads = 2;
    options.minMoves = 0;
    options.movesPerCell = 10;
    options.steps = 3;
    options.syncMoves = 0.1;
    options.timeLimit = 30;
    require(saThreads(db, options) == 2, "fixture did not enable parallel SA");
    Placement a = original, b = original;
    auto first = anneal(db, a, options);
    auto second = anneal(db, b, options);
    require(first.attempts > 0 && first.attempts == second.attempts, "inconsistent work budget");
    require(a.seg == b.seg && a.site == b.site, "fixed-work parallel SA was not deterministic");
    require(checkLegal(db, a).empty(), "parallel merge produced illegal placement");
    require(first.best <= first.initial + 1e-7, "parallel SA lost its incumbent");
    require(std::abs(totalHPWL(db, a) - first.best) < 1e-7, "merged HPWL cache disagrees with actual placement");

    require(first.limitCut == 0, "a well-fed SA cut its own time limit");

    // v6: a starved SA keeps only starvedMinFraction of its limit
    SAOptions starved = options;
    starved.starvedAttemptsPerCell = 1e15;
    starved.starvedMinFraction = 0.1;
    Placement s = original;
    auto cut = anneal(db, s, starved);
    require(cut.limitCut > 26.9 && cut.limitCut < 27.0 + 1e-9, "starved SA did not keep 10 % of its limit");
    require(cut.seconds < 3.5, "starved SA ran past its cut limit");
    require(checkLegal(db, s).empty() && cut.best <= cut.initial + 1e-7, "starved SA broke legality or its incumbent");

    options.timeLimit = 0;
    Placement stopped = original;
    auto expired = anneal(db, stopped, options);
    require(expired.attempts == 0, "parallel SA started a batch after its deadline");
    require(stopped.seg == original.seg && stopped.site == original.site, "zero-budget run changed the placement");
    std::cout << "PASS: parallel legality, HPWL cache, fixed-work determinism, starved cut, expired budget\n";
}
#!/usr/bin/env python3
"""Build and run the invariant/exhaustive regression suite without CMake."""
import argparse
import json
from pathlib import Path
import subprocess
import time

ROOT = Path(__file__).resolve().parents[1]


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--sanitize', action='store_true')
    parser.add_argument('--compiler', default='g++')
    args = parser.parse_args()
    out = ROOT.parents[1] / 'Testcases/results' / ROOT.name / ('tests_sanitized' if args.sanitize else 'tests')
    out.mkdir(parents=True, exist_ok=True)
    flags = ['-std=c++17', '-O1' if args.sanitize else '-O2', '-pthread', '-UNDEBUG']
    if args.sanitize:
        flags += ['-g', '-fsanitize=address,undefined', '-fno-omit-frame-pointer']
    records = []

    def run(command, label, timeout=180):
        start = time.perf_counter()
        process = subprocess.run(command, text=True, stdout=subprocess.PIPE,
                                 stderr=subprocess.STDOUT, timeout=timeout)
        (out / (label + '.log')).write_text(process.stdout)
        records.append({'label': label, 'command': command, 'returncode': process.returncode,
                        'seconds': time.perf_counter() - start})
        (out / 'records.json').write_text(json.dumps(records, indent=2) + '\n')
        print(label + ': ' + ('PASS' if process.returncode == 0 else 'FAIL'), flush=True)
        if process.returncode:
            print(process.stdout)
            raise SystemExit(process.returncode)

    objects = []
    for source in sorted((ROOT / 'src').glob('*.cpp')):
        if source.stem == 'main':
            continue
        obj = out / (source.stem + '.o')
        run([args.compiler, *flags, '-c', str(source), '-o', str(obj)], 'build_' + source.stem)
        objects.append(str(obj))
    for name in ('window', 'multirow', 'optimizer', 'chain', 'parallel_sa', 'pool', 'global', 'capsearch', 'cap_windows', 'guard'):
        exe = out / (name + '_test')
        run([args.compiler, *flags, str(ROOT / 'tests' / (name + '_test.cpp')),
             *objects, '-o', str(exe)], 'link_' + name)
        run([str(exe)], name)
    print('All 10 C++ test programs passed. Logs: ' + str(out), flush=True)


if __name__ == '__main__':
    main()
#!/usr/bin/env python3
"""phase2_train.py TAG [extra dp args] — Stage 1 of the current v6 source on the tuning set (testcases + holdout).

Copies AI_Solutions/<this results folder's name> (src + CMakeLists) to phase2/train/TAG/src, builds it there, records the
source hash, runs run_ts.py --no-sa -v on the 11 cases, and compares with this session's ChainDP / CodexCapDP
local_grade records (phase1/lg; for a later version: ClaudeOpus55_v6/final). Only testcases + holdout: edge is never used for tuning.
"""
import hashlib, json, shutil, subprocess, sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent))
from v6q import Queue, R, LAB, PY, V5S, build, note  # noqa: E402

tag = sys.argv[1]
extra = ' '.join(sys.argv[2:])
d = R / 'phase2' / 'train' / tag
if not (d / 'src').exists():
    d.mkdir(parents=True, exist_ok=True)
    shutil.copytree(LAB / 'AI_Solutions' / R.name / 'src', d / 'src')
    shutil.copy(LAB / 'AI_Solutions' / R.name / 'CMakeLists.txt', d / 'CMakeLists.txt')
src_hash = hashlib.sha256(b''.join(p.read_bytes() for p in sorted((d / 'src').iterdir()))).hexdigest()
(d / 'protocol.json').write_text(json.dumps(dict(tag=tag, src_sha256=src_hash, dp_args=extra), indent=1) + '\n')
exe = build('v6', d / 'build', src=d)
q = Queue(d)
q.run('stage1', [PY, V5S / 'run_ts.py', '--bin', exe, '--out', d / 'ts', f'--dp-args=--no-sa {extra}',
                 'Testcases/testcases', 'Testcases/holdout'])
# references: this results folder's own phase1/lg (v6's diagnosis) if present, else v6's final paired run
ref = R / 'phase1/lg' if (R / 'phase1/lg/CodexChainDP_27/record.csv').exists() else None
V6F = R.parent / 'ClaudeOpus55_v6' / 'final'
refs = (['CodexChainDP', ref / 'CodexChainDP_27/record.csv', 'CodexCapDP', ref / 'CodexCapDP_27/record.csv'] if ref else
        ['CodexChainDP', V6F / 'lg_CodexChainDP/record.csv', 'ClaudeOpus55_v6', V6F / 'lg_ClaudeOpus55_v6/record.csv'])
subprocess.run([PY, R / 'scripts/compare_lg.py', d / 'compare.md', *refs, f'{R.name}_{tag}', d / 'ts/record.csv', '--csv', d / 'compare.csv'],
               check=True)
subprocess.run([PY, R / 'scripts/stage1_phases.py', d / 'stage1', d / 'ts'], check=True)
note(f'phase2/train/{tag} 完成（{extra or "預設"}）：見 phase2/train/{tag}/compare.md')

