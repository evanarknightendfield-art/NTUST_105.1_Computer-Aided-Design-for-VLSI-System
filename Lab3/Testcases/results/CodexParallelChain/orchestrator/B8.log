bool readPlX(const PlaceDB& db, const std::string& path, Placement& p) {
    std::map<std::string, int> id;
    for (size_t i = 0; i < db.nodes.size(); ++i) id[db.nodes[i].name] = int(i);
    p.seg.assign(db.nodes.size(), -1);
    p.site.assign(db.nodes.size(), 0);
    std::ifstream f(path);
    std::string line;
    while (std::getline(f, line)) {
        std::istringstream ss(line);
        std::string n;
        double x, y;
        if (!(ss >> n >> x >> y)) continue;
        auto it = id.find(n);
        if (it == id.end()) continue;
    const double T0 = std::max(1.0, 0.5 * avgW);
    double T = T0;
    const double t1 = wallSeconds();
    std::vector<int> over;
    long it = 0;
    Trial t;
    while (cur > EPS) {
        // v6: the clock is read every move, not every 256: on a design with
        // a few long rows one move re-scores two segments of ~1400 cells
        // (2-7 ms on e07), and 256 of them overran a 0.4 s repair by 1.4 s
        // (Testcases/results/ClaudeOpus55_v6/diagnosis.md section 5)
        if (wallSeconds() >= until) break;
        if ((it & 255) == 0) {
            bad.clear();
            cur = 0;
            for (size_t s = 0; s < R.late.size(); ++s) {
                cur += R.late[s];
                if (R.late[s] > EPS) bad.push_back(int(s));
            }
            if (bad.empty()) break;
            // time-based: three cool-downs T0 -> 0.05 per slice (long rows do
            // few moves per second, an iteration-based schedule never cools)
            double frac = std::fmod(3.0 * (wallSeconds() - t1) / std::max(1e-3, until - t1), 1.0);
            T = T0 * std::pow(0.05 / T0, frac);
        }
        ++it;
        int s1 = bad[rng.below(int(bad.size()))];
        if (R.late[s1] <= EPS || R.list[s1].empty()) continue;
        // half of the time, a cell that is over the cap wherever it is now
        int v = -1;
        if (rng.u01() < 0.5) {
            over.clear();
            double lo, hi, pen;
            for (int c : R.list[s1])
                if (R.window(c, s1, lo, hi, pen) && pen > 0) over.push_back(c);
            if (!over.empty()) v = over[rng.below(int(over.size()))];
        }
        if (v < 0) v = R.list[s1][rng.below(int(R.list[s1].size()))];
        if (!propose(db, R, rng, v, t)) continue;
        double c1 = R.lateness(t.s1, t.l1), c2 = R.lateness(t.s2, t.l2);

