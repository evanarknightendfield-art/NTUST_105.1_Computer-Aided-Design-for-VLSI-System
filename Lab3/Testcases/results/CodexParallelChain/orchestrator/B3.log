@@ -0,0 +1,66 @@
+#include "../src/window.hpp"
+#include <iostream>
+#include <random>
+#include <stdexcept>
+
+namespace {
+void require(bool ok, const char* why) { if (!ok) throw std::runtime_error(why); }
+void addRow(PlaceDB& db, double y) {
+    int r = int(db.rows.size()), s = int(db.segs.size());
+    db.rows.push_back({y, 1, {s}});
+    db.segs.push_back({r, y, 1, 0, 1, 40});
+}
+void addCell(PlaceDB& db, Placement& p, int row, int site, double gx, double gy) {
+    Node n;
+    n.name = "c" + std::to_string(db.nodes.size());
+    n.w = 2; n.h = 1; n.gx = gx; n.gy = gy;
+    db.movable.push_back(int(db.nodes.size())); db.nodes.push_back(n);
+    p.seg.push_back(row); p.site.push_back(site);
+}
+void compare(const PlaceDB& db, const Placement& start, bool mustBatch) {
+    WindowOptions opt;
+    opt.passes = 4; opt.perRow = 2; opt.timeLimit = 60;
+    Placement serial = start, parallel = start, repeat = start;
+    TargetWindowStats s, p, r;
+    long a = targetedWindowsDisp(db, serial, opt, 2000, &s);
+    opt.threads = 4;
+    long b = targetedWindowsDisp(db, parallel, opt, 2000, &p);
+    long c = targetedWindowsDisp(db, repeat, opt, 2000, &r);
+    require(a == b && b == c, "accept counts differ");
+    require(serial.seg == parallel.seg && serial.site == parallel.site, "parallel differs from serial");
+    require(repeat.seg == parallel.seg && repeat.site == parallel.site, "parallel is not reproducible");
+    require(s.solved == p.solved && p.solved == r.solved, "solved counts differ");
+    require(checkLegal(db, parallel).empty(), "illegal parallel placement");
+    auto before = displacement(db, start), after = displacement(db, parallel);
+    require(after.total <= before.total + 1e-7 && after.max <= before.max + 1e-7, "Pareto bound violated");
+    if (mustBatch) require(p.maxBatch > 1 && a > 0, "fixture did not exercise concurrent accepted windows");
+    opt.timeLimit = 0;
+    require(targetedWindowsDisp(db, repeat, opt, 2000, &r) == 0 && r.solved == 0, "zero budget performed work");
+    require(repeat.seg == parallel.seg && repeat.site == parallel.site, "zero budget changed placement");
+}
+}
+
+int main() {
+    // Independent distant row pairs, then shared-segment conflicts and adjacent
+    // cells. All windows cross a hypothetical row-band boundary; none is lost.
+    PlaceDB db; Placement start;
+    for (int r = 0; r < 16; ++r) addRow(db, r * 3);
+    for (int r = 0; r < 8; ++r) addCell(db, start, r, 12, 4, (r + 8) * 3);
+    compare(db, start, true);
+    std::mt19937 rng(30123);
+    for (int trial = 0; trial < 60; ++trial) {
+        PlaceDB random; Placement p;
+        for (int r = 0; r < 8; ++r) addRow(random, r * 3);
+        for (int r = 0; r < 8; ++r)
+            for (int k = 0; k < 4; ++k)
+                addCell(random, p, r, k * 8, rng() % 37, (rng() % 8) * 3);
+        compare(random, p, false);
+    }
+    // Disjoint regions in the same segment still serialize, including bounds.
+    PlaceDB same; Placement p;
+    addRow(same, 0);
+    addCell(same, p, 0, 0, 34, 0); addCell(same, p, 0, 8, 26, 0);
+    addCell(same, p, 0, 26, 8, 0); addCell(same, p, 0, 34, 0, 0);
+    compare(same, p, false);
+    std::cout << "Target windows: parallel/serial equivalence, conflicts, distant targets, reproducibility and budgets passed\n";
+}
