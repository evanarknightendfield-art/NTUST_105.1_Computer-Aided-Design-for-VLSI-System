            std::vector<double> d(db.nodes.size());
            for (int v : anchors) d[v] = displacementOf(db, p, v);
            int count = std::min(int(anchors.size()), maxRoots);
            std::partial_sort(anchors.begin(), anchors.begin() + count, anchors.end(), [&](int a, int b) {
