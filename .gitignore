# Lab3: testcases are regenerated by Lab3/Testcases/make_testcases.sh;
# local grading runs and dp outputs from manual runs
/Lab3/Testcases/*/
/Lab3/Grader/local_grade_*/
/Lab3/**/out/

# Lab3 experiment runs: dp copies the input .aux/.nodes/.nets/.wts/.scl into
# every run directory (identical to the testcase), plus compiled binaries and
# extracted packages. The .pl outputs, traces, logs and records stay tracked.
/Lab3/**/results/**/output.aux
/Lab3/**/results/**/output.nodes
/Lab3/**/results/**/output.nets
/Lab3/**/results/**/output.wts
/Lab3/**/results/**/output.scl
/Lab3/**/results/**/bin/
/Lab3/**/results/package_check/home/
/Lab3/AI_Solutions/*/dp

# Everything else is tracked: source code, experiment results (SA is random,
# so they cannot be regenerated exactly), reports, examples and course PDFs.

# Editor and operating system temporary files
*.swp
*.swo
*~
.DS_Store
Thumbs.db

